<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121218">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍬 Candy Crush Auto Bot"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bản v1.0.7 - Auto Mod Engine (Không cần cài thêm app)"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hỗ trợ diệt Đầu Lâu (Sour Skull) • Mở Ổ Khóa • Phá Bánh Quế (Waffles)"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- Card danh sách cấp quyền -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E2A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CÁC QUYỀN VÀ TÍNH NĂNG HOẠT ĐỘNG"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Quyền 1: Overlay -->
            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Quyền Nút Home Ảo"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Cấp quyền Hiển thị Nút Home ảo"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="14dp" />

            <!-- Quyền 2: Accessibility -->
            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Dịch vụ Trợ Năng"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Bật Dịch vụ Trợ Năng (Để tự vuốt kẹo)"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="14dp" />

            <!-- Tính năng 3: Ghi/Chụp màn hình MediaProjection -->
            <TextView
                android:id="@+id/tvCaptureStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Chụp Màn Hình MediaProjection"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnStartCapture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Bật Chụp Màn Hình HD (Khuyến nghị)"
                android:backgroundTint="#009688"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Card Tùy Chỉnh Số Lượng Hack Booster -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#232336"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ TÙY CHỈNH SỐ LƯỢNG BOOSTER HACK"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tự do nhập số lượng bất kỳ (ví dụ 999 hoặc 9999). Dùng đến đâu tự trừ đến đó!"
                android:textColor="#B0BEC5"
                android:textSize="11.5sp"
                android:layout_marginBottom="12dp" />

            <!-- 1. Búa Lollipop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="🔨 Búa Kẹo Mút (Hammer):"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etHammerCount"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:background="#121218"
                    android:textColor="#FFD54F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="999" />
            </LinearLayout>

            <!-- 2. Đĩa Bay UFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="🛸 Đĩa Bay Vũ Trụ (UFO):"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etUfoCount"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:background="#121218"
                    android:textColor="#CE93D8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="999" />
            </LinearLayout>

            <!-- 3. Bàn Tay Tráo Kẹo (Free Switch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="✋ Bàn Tay Tự Do (Free Switch):"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etHandCount"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:background="#121218"
                    android:textColor="#80D8FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="999" />
            </LinearLayout>

            <!-- 4. Tiệc Pinata (Party Booster) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="🎉 Bữa Tiệc Pinata (Party):"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPartyCount"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:background="#121218"
                    android:textColor="#FF8A80"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="999" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveBoosters"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="💾 LƯU SỐ LƯỢNG HACK BOOSTER"
                android:backgroundTint="#00C853"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartFloating"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🚀 BẬT NÚT HOME ẢO NGAY"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnStopFloating"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🛑 TẮT BOT &amp; ĐÓNG NÚT HOME ẢO"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- Hướng dẫn nhanh -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 HƯỚNG DẪN:\n1. Bật Quyền 1, 2 và bấm nút số 3 để ghi nhận hình ảnh chuẩn nhất.\n2. Bấm 'BẬT NÚT HOME ẢO NGAY' để hiện biểu tượng kẹo tròn 🍬.\n3. Mở game Candy Crush Saga, chạm vào nút 🍬 để bot tự đánh thông minh.\n4. Bấm nút đỏ ✕ ở góc để dừng bot và đóng nút bất kỳ lúc nào!"
            android:textColor="#9E9E9E"
            android:textSize="12.5sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />
    </LinearLayout>
</ScrollView>
