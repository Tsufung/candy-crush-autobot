<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121218">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍬 Candy Crush Auto Bot"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bản v1.0.5 - Smart Booster 999 &amp; King AI (Cập nhật trực tiếp)"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hỗ trợ diệt Đầu Lâu (Sour Skull) • Mở Ổ Khóa • Phá Bánh Quế (Waffles)"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- Card danh sách cấp quyền -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E2A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CÁC QUYỀN VÀ TÍNH NĂNG HOẠT ĐỘNG"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Quyền 1: Overlay -->
            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Quyền Nút Home Ảo"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Cấp quyền Hiển thị Nút Home ảo"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="14dp" />

            <!-- Quyền 2: Accessibility -->
            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Dịch vụ Trợ Năng"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Bật Dịch vụ Trợ Năng (Để tự vuốt kẹo)"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="14dp" />

            <!-- Tính năng 3: Ghi/Chụp màn hình MediaProjection -->
            <TextView
                android:id="@+id/tvCaptureStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Chụp Màn Hình MediaProjection"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnStartCapture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Bật Chụp Màn Hình HD (Khuyến nghị)"
                android:backgroundTint="#009688"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartFloating"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🚀 BẬT NÚT HOME ẢO NGAY"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnStopFloating"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🛑 TẮT BOT &amp; ĐÓNG NÚT HOME ẢO"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- Hướng dẫn nhanh -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 HƯỚNG DẪN:\n1. Bật Quyền 1, 2 và bấm nút số 3 để ghi nhận hình ảnh chuẩn nhất.\n2. Bấm 'BẬT NÚT HOME ẢO NGAY' để hiện biểu tượng kẹo tròn 🍬.\n3. Mở game Candy Crush Saga, chạm vào nút 🍬 để bot tự đánh thông minh.\n4. Bấm nút đỏ ✕ ở góc để dừng bot và đóng nút bất kỳ lúc nào!"
            android:textColor="#9E9E9E"
            android:textSize="12.5sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />
    </LinearLayout>
</ScrollView>
